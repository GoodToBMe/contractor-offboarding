        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Get user from contractor field and  set locked_out to true and active to false

	var contrctr = new GlideRecord('sys_user');
	contrctr.get(current.contractor.contractor);
	contrctr.setValue('locked_out', true);
	contrctr.setValue('active', false);
	contrctr.update();
	
	// Set asset to pending return
	var assets = new GlideRecord('alm_hardware');
	assets.addQuery('assigned_to',contrctr);
	assets.query();

	while(assets.next()){
		assets.setValue('install_status',5);
		assets.update();
	}

})(current, previous);]]></script>
